{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OCEAN",
  "version": "1.0.7",
  "identifier": "taallab.ocean",
  "build": {
    "devUrl": "https://ocean.taallab.in",
    "frontendDist": "https://ocean.taallab.in"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OCEAN",
        "url": "https://ocean.taallab.in",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Your TaalLab workspace",
    "longDescription": "OCEAN is your private TaalLab workspace for notes, pages and ideas.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}